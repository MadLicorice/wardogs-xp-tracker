<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:WardogsXpTracker.App">
    <Style x:Key="MainTableHeaderGripStyle" TargetType="Thumb">
        <Setter Property="Width" Value="7" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" /></ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="MainTableColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#26313D" />
        <Setter Property="Foreground" Value="#CFD9E5" />
        <Setter Property="BorderBrush" Value="#405165" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Padding" Value="8,9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ToolTip" Value="Click to sort this column. Hold Shift to sort by more than one column." />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="DataGridColumnHeader">
                <Grid>
                    <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="17" /></Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              RecognizesAccessKey="True" />
                            <Path x:Name="SortArrow" Grid.Column="1" Fill="#F0CE6D" Stroke="#F0CE6D" StrokeThickness="0.8"
                                  Width="12" Height="16" Stretch="Fill" Margin="3,0,0,0" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Visibility="Hidden" AutomationProperties.Name="Sort direction"
                                  Data="M 5,0 L 10,5 L 7,5 L 7,12 L 3,12 L 3,5 L 0,5 Z" />
                        </Grid>
                    </Border>
                    <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource MainTableHeaderGripStyle}" />
                    <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource MainTableHeaderGripStyle}" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="#344456" /></Trigger>
                    <Trigger Property="SortDirection" Value="Ascending">
                        <Setter TargetName="SortArrow" Property="Data" Value="M 5,0 L 10,5 L 7,5 L 7,12 L 3,12 L 3,5 L 0,5 Z" /><Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                        <Setter Property="ToolTip" Value="Sorted ascending ↑. Click to reverse the order." />
                    </Trigger>
                    <Trigger Property="SortDirection" Value="Descending">
                        <Setter TargetName="SortArrow" Property="Data" Value="M 3,0 L 7,0 L 7,7 L 10,7 L 5,12 L 0,7 L 3,7 Z" /><Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                        <Setter Property="ToolTip" Value="Sorted descending ↓. Click to reverse the order." />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
    <Style x:Key="MainTableRowStyle" TargetType="DataGridRow">
        <Setter Property="Foreground" Value="#DFE6EE" />
        <Setter Property="BorderBrush" Value="#303A48" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsSelected" Value="True" /><Condition Property="Selector.IsSelectionActive" Value="True" /></MultiTrigger.Conditions>
                <Setter Property="Background" Value="#314A62" /><Setter Property="Foreground" Value="#F1F5FA" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="MainTableCellStyle" TargetType="DataGridCell">
        <Setter Property="Padding" Value="7,6" /><Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#DFE6EE" /><Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="DataGridCell">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="True" />
                </Border>
            </ControlTemplate>
        </Setter.Value></Setter>
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions><Condition Property="IsSelected" Value="True" /><Condition Property="Selector.IsSelectionActive" Value="True" /></MultiTrigger.Conditions>
                <Setter Property="Background" Value="#314A62" /><Setter Property="Foreground" Value="#F1F5FA" />
                <Setter Property="BorderBrush" Value="#718BA5" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="MainTableStyle" TargetType="DataGrid">
        <Style.Resources>
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#314A62" />
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F1F5FA" />
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#DFE6EE" />
        </Style.Resources>
        <Setter Property="Background" Value="#171E27" /><Setter Property="Foreground" Value="#DFE6EE" />
        <Setter Property="RowBackground" Value="#1D2530" /><Setter Property="AlternatingRowBackground" Value="#19212B" />
        <Setter Property="BorderBrush" Value="#354150" /><Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#303A48" /><Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" /><Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" /><Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" /><Setter Property="CanUserSortColumns" Value="True" />
        <Setter Property="SelectionUnit" Value="FullRow" /><Setter Property="SelectionMode" Value="Single" />
        <Setter Property="local:TableInteraction.Enabled" Value="True" />
        <Setter Property="EnableRowVirtualization" Value="True" /><Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="FontSize" Value="11" /><Setter Property="MinHeight" Value="90" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource MainTableColumnHeaderStyle}" />
        <Setter Property="RowStyle" Value="{StaticResource MainTableRowStyle}" />
        <Setter Property="CellStyle" Value="{StaticResource MainTableCellStyle}" />
    </Style>
    <Style TargetType="DataGrid" BasedOn="{StaticResource MainTableStyle}" />
    <Style TargetType="DataGridRow" BasedOn="{StaticResource MainTableRowStyle}" />
    <Style TargetType="DataGridCell" BasedOn="{StaticResource MainTableCellStyle}" />
    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MainTableColumnHeaderStyle}" />
</ResourceDictionary>
