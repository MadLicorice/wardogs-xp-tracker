<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework><UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CaptureProjectPath Condition="'$(CaptureProjectPath)' == ''">../../src/WardogsXpTracker.Windows/WardogsXpTracker.Windows.csproj</CaptureProjectPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(CaptureSourceRoot)' == ''"><ProjectReference Include="$(CaptureProjectPath)" /></ItemGroup>
  <ItemGroup Condition="'$(CaptureSourceRoot)' != ''"><Compile Include="$(CaptureSourceRoot)/*.cs" Link="Capture/%(Filename)%(Extension)" /></ItemGroup>
</Project>
